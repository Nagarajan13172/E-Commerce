# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust. NEVER commit a real .env.
# The API parses every variable below with Zod at boot and refuses to start
# if anything required is missing or malformed (see apps/api/src/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Public origins
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma-separated CORS allowlist (credentials are enabled, so no wildcards)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── MongoDB ──────────────────────────────────────────────────────────────────
# directConnection=true lets a single-node replica set work from both the host
# and other containers regardless of the hostname the replica set advertises.
# The replica set itself is REQUIRED: multi-item checkout uses transactions.
MONGODB_URI=mongodb://localhost:27017/ecommerce?directConnection=true
MONGODB_URI_TEST=mongodb://localhost:27017/ecommerce_test?directConnection=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32
CSRF_SECRET=replace-me-with-another-long-random-string-min-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
# Set true in production (requires HTTPS)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=false

# ── Redis (optional: CacheService falls back to in-memory LRU when unset) ─────
REDIS_URL=redis://localhost:6379

# ── MinIO / S3-compatible object storage ─────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ecom-media
# Browser-facing base URL for public objects (CDN origin in production)
STORAGE_PUBLIC_URL=http://localhost:9000/ecom-media
STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_SIZE_MB=10

# ── Payments ─────────────────────────────────────────────────────────────────
# mock | razorpay
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
# Mock provider: signs exactly like Razorpay (HMAC-SHA256) so the verification
# and webhook code paths are real. Swap PAYMENT_PROVIDER to move to Razorpay.
MOCK_PAYMENT_KEY_ID=mock_key_local
MOCK_PAYMENT_KEY_SECRET=mock_secret_local_change_me
MOCK_PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Mailpit in dev; any SMTP in production) ────────────────────────────
# smtp | console
EMAIL_PROVIDER=smtp
EMAIL_FROM="Aurora Store <no-reply@aurora.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Commerce rules ───────────────────────────────────────────────────────────
DEFAULT_TAX_RATE=0.18
FREE_SHIPPING_THRESHOLD=999
DEFAULT_SHIPPING_FEE=49
STOCK_RESERVATION_MINUTES=15
ORDER_RETURN_WINDOW_DAYS=7

# ── Web (Vite: only VITE_* is exposed to the browser bundle) ──────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Aurora
